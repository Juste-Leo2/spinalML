// ==============================================================================
// SpinalML Physical Constraints - Sipeed Tang Primer 20K
// FPGA: Gowin GW2A-LV18PG256C8/I7
// SPDX-License-Identifier: MIT
// ==============================================================================

// Onboard 27 MHz Clock Oscillator
IO_LOC "clk" H11;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Pushbutton S1 (Active Low Reset)
IO_LOC "reset_n" T10;
IO_PORT "reset_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// USB-UART Interface (pins routed to onboard FTDI debugger)
// RX: Board receives from PC (FTDI TX)
IO_LOC "uart_rx" T13;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// TX: Board transmits to PC (FTDI RX)
IO_LOC "uart_tx" M11;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// DDR3 SDRAM (H5TC1G63EFR, 64Mx16 — same x16 footprint as other revisions).
// Pinout from litex-boards Sipeed Tang Primer 20K platform; only used when
// the top module exposes ddram_* ports (DramSoCTop, i.e. --dram builds).
// Board signals use litex-style base names (ddram_a); the build engine maps
// top ports (io_ddram_a) onto them and expands buses per bit.
IO_LOC "ddram_a[0]" F7;
IO_PORT "ddram_a[0]" IO_TYPE=SSTL15;
IO_LOC "ddram_a[1]" A4;
IO_PORT "ddram_a[1]" IO_TYPE=SSTL15;
